{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mon Miam Miam Bureau",
  "version": "0.1.0",
  "identifier": "cd.monmiammiam.desktop",
  "build": {
    "beforeDevCommand": "node scripts/ensure-vite.mjs",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mon Miam Miam · Bureau",
        "url": "desktop.html",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "backgroundColor": "#101a20"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
