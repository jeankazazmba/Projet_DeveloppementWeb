        <mxCell id="wait" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" value="Attendre une première commande réussie avant d&#39;attribuer la récompense" vertex="1">
